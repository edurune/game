{
  "name": "edurune-data",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "workspaces": [
    "art",
    "artroom"
  ],
  "type": "module",
  "scripts": {
    "art:dev": "bun run --cwd artroom dev",
    "art:build": "bun run --cwd artroom build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "i18n:extract": "bun run --cwd art i18n:extract",
    "i18n:compile": "bun run --cwd art i18n:compile",
    "i18n": "bun run i18n:extract && bun run i18n:compile"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/conf": "6.7.0",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-svgr": "5.2.0"
  }
}
